# Configuración de S3
# Endpoint de tu servicio S3 (AWS S3, MinIO, DigitalOcean Spaces, etc.)
S3_ENDPOINT=https://s3.amazonaws.com

# Región de S3
S3_REGION=us-east-1

# Credenciales de acceso a S3
S3_ACCESS_KEY_ID=tu_access_key_aqui
S3_SECRET_ACCESS_KEY=tu_secret_key_aqui

# Nombre del bucket donde están almacenadas las canciones
S3_BUCKET_NAME=nombre-de-tu-bucket
